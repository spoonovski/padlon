rules_version = '2';
// Pravidla pro matchmaking. Vlož je ve Firebase → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // přihlášený hráč (jméno + heslo), ne anonymní návštěvník
    function isPlayer() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'password'; }
    function shortStr(v, n) { return v is string && v.size() <= n; }

    // Profil hráče: {name, created, prefs, photo}, mění ho jen on sám
    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if isPlayer() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'created', 'prefs', 'photo'])
        && (!('photo' in request.resource.data) || request.resource.data.photo == null
            || (request.resource.data.photo is string && request.resource.data.photo.size() < 200000
                && request.resource.data.photo.matches('^data:image/jpeg;base64,.*')))
        && shortStr(request.resource.data.name, 24) && request.resource.data.name.size() > 0
        && (!('prefs' in request.resource.data) || (request.resource.data.prefs is map && request.resource.data.prefs.size() <= 7));
      allow delete: if isPlayer() && request.auth.uid == uid;
    }

    // Volno hráče na jeden den: {player, name, date, slots, updated}, mění ho jen on sám
    match /availability/{id} {
      allow read: if signedIn();
      allow create, update: if isPlayer()
        && request.resource.data.player == request.auth.uid
        && request.resource.data.keys().hasOnly(['player', 'name', 'date', 'slots', 'updated'])
        && shortStr(request.resource.data.name, 24)
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.slots.matches('^[01]{36}$')
        && id == request.auth.uid + '_' + request.resource.data.date;
      allow delete: if isPlayer() && resource.data.player == request.auth.uid;
    }

    // Zápas: zakládají, přidávají se a zapisují výsledky přihlášení hráči
    function validMatch(d) {
      return d.keys().hasOnly(['date', 'start', 'dur', 'venue', 'venueName', 'url',
               'players', 'names', 'invited', 'booked', 'created', 'by', 'winners', 'losers', 'score',
               'price', 'priceMode', 'qr', 'paid', 'pos', 'chatN', 'closed', 'holds', 'winSide'])
        && (!('winners' in d) || (d.winners is list && d.winners.size() <= 2))
        && (!('losers' in d) || (d.losers is list && d.losers.size() <= 2))
        && (!('score' in d) || shortStr(d.score, 30))
        && d.players is list && d.players.size() <= 4
        && d.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && d.dur in [90, 120]
        && (d.get('qr', null) == null
            || (d.qr is string && d.qr.size() < 300000 && d.qr.matches('^data:image/(png|jpeg);base64,.*')))
        && (d.get('price', null) == null || (d.price is number && d.price <= 100000))
        && (d.get('paid', []) is list && d.get('paid', []).size() <= 4)
        && (d.get('pos', {}) is map && d.get('pos', {}).size() <= 12)
        && (d.get('chatN', 0) is int)
        && (d.get('closed', false) is bool)
        && d.get('winSide', null) in [null, 'A', 'B']
        // držená místa: mapa {uid nebo any0..any2: {by, name, pos}}; hráči + držená místa nejvýš 4
        && (d.get('holds', {}) is list
            || (d.get('holds', {}) is map && d.get('holds', {}).size() <= 3
                && d.players.size() + d.get('holds', {}).size() <= 4));
    }
    function holdsOf(d) { return d.get('holds', {}) is map ? d.get('holds', {}) : {}; }
    // Hráč, který se přidává, smí z držených míst odebrat jen to svoje nebo jedno bez jména.
    // Měnit držená místa jinak smí jen hráči zápasu (a každý může zrušit to, co je drženo pro něj).
    function holdsOk() {
      let ch = holdsOf(request.resource.data).diff(holdsOf(resource.data));
      let joining = (request.auth.uid in request.resource.data.players) && !(request.auth.uid in resource.data.players);
      return joining
        ? (ch.addedKeys().size() == 0 && ch.changedKeys().size() == 0 && ch.removedKeys().size() <= 1
           && ch.removedKeys().hasOnly([request.auth.uid, 'any0', 'any1', 'any2'])
           && (ch.removedKeys().size() == 1 || !(request.auth.uid in holdsOf(resource.data))))
        : (ch.affectedKeys().size() == 0
           || request.auth.uid in resource.data.players
           || (ch.affectedKeys().hasOnly([request.auth.uid]) && ch.addedKeys().size() == 0 && ch.changedKeys().size() == 0));
    }
    match /matches/{id} {
      allow read: if signedIn();
      allow create: if isPlayer() && validMatch(request.resource.data)
        && request.resource.data.get('booked', null) in [null, request.auth.uid];
      allow update: if isPlayer() && validMatch(request.resource.data) && holdsOk()
        // rezervujícím se může označit jen každý sám (nebo rezervaci zrušit)
        && (request.resource.data.get('booked', null) == resource.data.get('booked', null)
            || request.resource.data.get('booked', null) == null
            || request.resource.data.get('booked', null) == request.auth.uid)
        // cenu a QR mění jen ten, kdo kurt zarezervoval (nebo se mažou spolu s rezervací)
        && ((request.resource.data.get('qr', null) == resource.data.get('qr', null)
             && request.resource.data.get('price', null) == resource.data.get('price', null))
            || request.auth.uid == resource.data.get('booked', null)
            || (request.resource.data.get('qr', null) == null && request.resource.data.get('price', null) == null));
      allow delete: if isPlayer();

      // Chat zápasu: {uid, name, text, ts}, každý píše jen sám za sebe
      match /chat/{msg} {
        allow read: if signedIn();
        allow create: if isPlayer()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'ts'])
          && request.resource.data.uid == request.auth.uid
          && shortStr(request.resource.data.name, 24)
          && shortStr(request.resource.data.text, 500) && request.resource.data.text.size() > 0
          && request.resource.data.ts is int;
        allow delete: if isPlayer() && resource.data.uid == request.auth.uid;
      }
    }
  }
}
