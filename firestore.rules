rules_version = '2';
// Pravidla pro matchmaking. Vlož je ve Firebase → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // přihlášený hráč (jméno + heslo), ne anonymní návštěvník
    function isPlayer() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'password'; }
    function shortStr(v, n) { return v is string && v.size() <= n; }

    // Profil hráče: {name, created, prefs, photo}, mění ho jen on sám
    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if isPlayer() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'created', 'prefs', 'photo'])
        && (!('photo' in request.resource.data) || request.resource.data.photo == null
            || (request.resource.data.photo is string && request.resource.data.photo.size() < 200000
                && request.resource.data.photo.matches('^data:image/jpeg;base64,.*')))
        && shortStr(request.resource.data.name, 24) && request.resource.data.name.size() > 0
        && (!('prefs' in request.resource.data) || (request.resource.data.prefs is map && request.resource.data.prefs.size() <= 7));
      allow delete: if isPlayer() && request.auth.uid == uid;
    }

    // Volno hráče na jeden den: {player, name, date, slots, updated}, mění ho jen on sám
    match /availability/{id} {
      allow read: if signedIn();
      allow create, update: if isPlayer()
        && request.resource.data.player == request.auth.uid
        && request.resource.data.keys().hasOnly(['player', 'name', 'date', 'slots', 'updated'])
        && shortStr(request.resource.data.name, 24)
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.slots.matches('^[01]{36}$')
        && id == request.auth.uid + '_' + request.resource.data.date;
      allow delete: if isPlayer() && resource.data.player == request.auth.uid;
    }

    // Zápas: zakládají, přidávají se a zapisují výsledky přihlášení hráči
    match /matches/{id} {
      allow read: if signedIn();
      allow create, update: if isPlayer()
        && request.resource.data.keys().hasOnly(['date', 'start', 'dur', 'venue', 'venueName', 'url',
             'players', 'names', 'invited', 'booked', 'created', 'by', 'winners', 'losers', 'score'])
        && (!('winners' in request.resource.data) || (request.resource.data.winners is list && request.resource.data.winners.size() <= 2))
        && (!('losers' in request.resource.data) || (request.resource.data.losers is list && request.resource.data.losers.size() <= 2))
        && (!('score' in request.resource.data) || shortStr(request.resource.data.score, 30))
        && request.resource.data.players is list && request.resource.data.players.size() <= 4
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.dur in [90, 120];
      allow delete: if isPlayer();
    }
  }
}
